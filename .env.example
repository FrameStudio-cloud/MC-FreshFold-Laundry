# Where the storefront's data comes from. Optional.
#
# With no token the site still works: it renders entirely from
# src/data/business.js. That is what keeps this deployable as a plain static
# site with no secrets in it, and it is why the FAQ falls back to config rather
# than rendering empty when the API is unreachable.
#
# WITH a token, /api/page-content?page=faq&section=items is read so the FAQ can
# be edited from Keel -> Website without a deploy. Everything else stays in
# business.js.

VITE_KEEL_API_BASE=https://keel-api-37rh.onrender.com

# Per-shop site token. Digits only for the WhatsApp number, but the token itself
# is an opaque 48-char hex string.
#
# keel-api removed its Origin/Referer hostname fallback on 30 Sep 2026, and
# correctly so: an Origin header is not a credential. Without a token every
# request is a 401.
#
# A READ token is enough for the FAQ. A write token additionally allows
# POST /api/page-views and /api/events.
#
# Issue one by hand — nothing does it automatically:
#   select * from public.admin_issue_site_tokens(
#     (select value from public.app_config where key = 'keel_docs_admin_token'),
#     '<shop_id>'::uuid, 'label');
#
# WARNING: issuing revokes any existing active token for that shop (one active
# token per shop), so the site 401s until the new value is in the build.
VITE_KEEL_SITE_TOKEN=