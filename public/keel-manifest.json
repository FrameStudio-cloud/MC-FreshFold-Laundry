{
  "version": 1,
  "features": {
    "chat_widget": {
      "name": "WhatsApp Button",
      "description": "Floating button that opens WhatsApp with a pre-filled order message",
      "icon": "message-circle",
      "configurable": [
        {
          "key": "whatsapp_number",
          "type": "tel",
          "label": "WhatsApp Number",
          "placeholder": "254700000000"
        },
        {
          "key": "position",
          "type": "select",
          "label": "Position",
          "options": ["right", "left"]
        }
      ]
    },
    "back_to_top": {
      "name": "Back To Top",
      "description": "Appears once the visitor scrolls down the page",
      "icon": "arrow-up",
      "configurable": []
    }
  },
  "pages": {
    "faq": {
      "label": "FAQ",
      "description": "Questions customers ask before their first wash",
      "icon": "faq",
      "sections": [
        {
          "key": "items",
          "label": "Questions & Answers",
          "description": "Shown in the FAQ accordion on the site. The first question is open by default.",
          "fields": [
            {
              "key": "items",
              "type": "array",
              "label": "FAQ Items",
              "description": "Add, reorder or remove questions. The order here is the order on the site.",
              "addLabel": "Add Question",
              "itemFields": [
                {
                  "key": "question",
                  "type": "text",
                  "label": "Question",
                  "placeholder": "How long does a wash & fold take?"
                },
                {
                  "key": "answer",
                  "type": "textarea",
                  "label": "Answer",
                  "placeholder": "One or two sentences. Plain language."
                }
              ]
            }
          ]
        }
      ]
    },
    "delivery": {
      "label": "Delivery & pickup",
      "description": "Where you collect, and what you promise",
      "icon": "truck",
      "sections": [
        {
          "key": "details",
          "label": "Pickup details",
          "description": "Shown in the services intro, the how-it-works note and the contact card.",
          "fields": [
            {
              "key": "note",
              "type": "textarea",
              "label": "What you promise about collection",
              "placeholder": "We collect free within Kariani. Elsewhere we confirm on WhatsApp."
            },
            {
              "key": "same_day",
              "type": "text",
              "label": "Same-day note",
              "placeholder": "Order before 10:00 AM for same-day collection."
            },
            {
              "key": "areas",
              "type": "array",
              "label": "Areas you cover",
              "description": "Shown as pills in the contact card, in this order.",
              "addLabel": "Add area",
              "itemFields": [
                {
                  "key": "name",
                  "type": "text",
                  "label": "Area",
                  "placeholder": "Kariani"
                }
              ]
            }
          ]
        }
      ]
    },
    "location": {
      "label": "Location",
      "description": "Where the shop is, and how to find it",
      "icon": "map-pin",
      "sections": [
        {
          "key": "details",
          "label": "Address & map",
          "description": "Shown on the map card in the contact section.",
          "fields": [
            {
              "key": "address_line",
              "type": "text",
              "label": "Address",
              "description": "The line shown on the map card and used to build a directions link.",
              "placeholder": "Kariani Main Road, near the blue gate"
            },
            {
              "key": "landmark_note",
              "type": "textarea",
              "label": "How to find you",
              "description": "Optional. Shown under the address on the map card.",
              "placeholder": "Free collection point. Look for the blue gate next to the pharmacy."
            },
            {
              "key": "map_link_url",
              "type": "text",
              "label": "Google Maps link",
              "description": "Google Maps > Share > Copy link. Leave blank and the address above is used to build one.",
              "placeholder": "https://maps.app.goo.gl/..."
            },
            {
              "key": "map_embed_url",
              "type": "text",
              "label": "Google Maps embed URL",
              "description": "Google Maps > Share > Embed a map, then copy only what is inside the src=\"...\". Blank shows the designed placeholder.",
              "placeholder": "https://www.google.com/maps/embed?pb=..."
            }
          ]
        }
      ]
    },
    "testimonials": {
      "label": "Testimonials",
      "description": "What customers say",
      "icon": "quote",
      "sections": [
        {
          "key": "items",
          "label": "Reviews",
          "description": "Shown in the reviews section, in this order.",
          "fields": [
            {
              "key": "title",
              "type": "text",
              "label": "Section heading",
              "placeholder": "What customers say"
            },
            {
              "key": "items",
              "type": "array",
              "label": "Reviews",
              "description": "Only real quotes. These are published under the shop's name, so an invented one is a real problem.",
              "addLabel": "Add review",
              "itemFields": [
                {
                  "key": "quote",
                  "type": "textarea",
                  "label": "What they said",
                  "placeholder": "They called before 9am and it was back the same afternoon."
                },
                {
                  "key": "name",
                  "type": "text",
                  "label": "Name",
                  "placeholder": "Wanjiku"
                },
                {
                  "key": "area",
                  "type": "text",
                  "label": "Area",
                  "placeholder": "Kariani"
                },
                {
                  "key": "service",
                  "type": "text",
                  "label": "Service used",
                  "placeholder": "Wash & fold"
                },
                {
                  "key": "rating",
                  "type": "text",
                  "label": "Rating out of 5",
                  "description": "A number from 1 to 5. Left blank, or anything unreadable, is treated as 5.",
                  "placeholder": "5"
                }
              ]
            }
          ]
        }
      ]
    },
    "hero": {
      "label": "Homepage banner",
      "description": "The first thing a visitor reads",
      "icon": "sparkles",
      "sections": [
        {
          "key": "banner",
          "label": "Banner",
          "description": "The headline and buttons above the fold. {area}, {city} and {name} are replaced with your details.",
          "fields": [
            {
              "key": "eyebrow",
              "type": "text",
              "label": "Small line above the headline",
              "placeholder": "Laundry in {area} since 2016"
            },
            {
              "key": "headline",
              "type": "text",
              "label": "Headline",
              "placeholder": "Your laundry, folded and fresh"
            },
            {
              "key": "headline_accent",
              "type": "text",
              "label": "Headline, second line",
              "placeholder": "back before dinner."
            },
            {
              "key": "subtext",
              "type": "textarea",
              "label": "Paragraph under the headline",
              "placeholder": "Wash & fold collected from your door in {area}."
            },
            {
              "key": "primary_cta",
              "type": "text",
              "label": "First button text",
              "placeholder": "Order on WhatsApp"
            },
            {
              "key": "secondary_cta",
              "type": "text",
              "label": "Second button text",
              "placeholder": "See our prices"
            },
            {
              "key": "trust",
              "type": "array",
              "label": "Trust chips under the buttons",
              "description": "Short promises, shown side by side.",
              "addLabel": "Add a promise",
              "itemFields": [
                {
                  "key": "label",
                  "type": "text",
                  "label": "Promise",
                  "placeholder": "Free pickup & delivery"
                },
                {
                  "key": "icon",
                  "type": "text",
                  "label": "Icon name",
                  "description": "",
                  "placeholder": "truck, bolt, leaf, shield, timer"
                }
              ]
            }
          ]
        }
      ]
    },
    "how_it_works": {
      "label": "How it works",
      "description": "The steps a customer follows",
      "icon": "hanger",
      "sections": [
        {
          "key": "steps",
          "label": "Steps",
          "description": "Shown in order, numbered automatically.",
          "fields": [
            {
              "key": "eyebrow",
              "type": "text",
              "label": "Small line above the heading",
              "placeholder": "How it works"
            },
            {
              "key": "title",
              "type": "text",
              "label": "Heading",
              "placeholder": "Four steps, no errands"
            },
            {
              "key": "intro",
              "type": "textarea",
              "label": "Paragraph under the heading",
              "placeholder": "Everything happens over WhatsApp."
            },
            {
              "key": "steps",
              "type": "array",
              "label": "Steps",
              "description": "The order here is the order on the site.",
              "addLabel": "Add a step",
              "itemFields": [
                {
                  "key": "title",
                  "type": "text",
                  "label": "Step title",
                  "placeholder": "We pick up"
                },
                {
                  "key": "body",
                  "type": "textarea",
                  "label": "What happens",
                  "placeholder": "Free collection in {area}, usually next morning."
                },
                {
                  "key": "icon",
                  "type": "text",
                  "label": "Icon name",
                  "description": "",
                  "placeholder": "truck, bolt, leaf, shield, timer"
                }
              ]
            }
          ]
        }
      ]
    },
    "benefits": {
      "label": "Why choose us",
      "description": "What customers say makes you different",
      "icon": "leaf",
      "sections": [
        {
          "key": "items",
          "label": "Benefits",
          "description": "Shown side by side. {name}, {area} and {city} are replaced with your details.",
          "fields": [
            {
              "key": "eyebrow",
              "type": "text",
              "label": "Small line above the heading",
              "placeholder": "Why {name}"
            },
            {
              "key": "title",
              "type": "text",
              "label": "Heading",
              "placeholder": "The things people actually notice"
            },
            {
              "key": "intro",
              "type": "textarea",
              "label": "Paragraph under the heading",
              "placeholder": "Optional."
            },
            {
              "key": "items",
              "type": "array",
              "label": "Benefits",
              "description": "The order here is the order on the site.",
              "addLabel": "Add a benefit",
              "itemFields": [
                {
                  "key": "title",
                  "type": "text",
                  "label": "Benefit title",
                  "placeholder": "Colours stay separate"
                },
                {
                  "key": "body",
                  "type": "textarea",
                  "label": "What it means",
                  "placeholder": "Sorted into lights, darks and reds first."
                },
                {
                  "key": "icon",
                  "type": "text",
                  "label": "Icon name",
                  "description": "",
                  "placeholder": "truck, bolt, leaf, shield, timer"
                }
              ]
            }
          ]
        }
      ]
    }
  }
}